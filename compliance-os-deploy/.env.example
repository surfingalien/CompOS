# ---------------------------------------------------------------- core
# Relative path works both locally and in Docker (WORKDIR /app -> /app/data volume)
DATABASE_URL=sqlite:///./data/compliance_os.db
# Seed sample records (vendors, DSAR, incident...) so every screen has data. Set false for a clean tenant.
SEED_DEMO_DATA=true

# Require header X-API-Key on every /v1 call (the UI prompts for it once)
AUTH_ENABLED=false
API_KEY=

# ---------------------------------------------------------------- evidence connectors
# AWS (read-only IAM permissions: sts:GetCallerIdentity, ec2:GetEbsEncryptionByDefault,
# s3:GetAccountPublicAccessBlock, kms:ListKeys, cloudtrail:DescribeTrails, cloudtrail:GetTrailStatus)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Okta (read-only admin API token)
OKTA_ORG_URL=
OKTA_API_TOKEN=
OKTA_MAX_USERS=500

# GitHub (fine-grained token with read access to Administration + Metadata, or classic token with repo scope)
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_MAX_REPOS=200

# ---------------------------------------------------------------- intelligence
# The Federal Register API (US rules) and regulator RSS feeds need no key.
# Internet search for non-US regulators and state-law radar: none | mock | tavily | brave | serpapi | perplexity
SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
PERPLEXITY_API_KEY=

# Legal AI / Policy AI / Questionnaire drafting: none | anthropic | openai
# (none = rule-based extraction and template policies)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Identify yourself to regulator websites (SEC requires a contact in the User-Agent)
HTTP_USER_AGENT=CompOS/3.1 (compliance-radar; contact: you@yourcompany.com)

# Run Global Radar + Market sync automatically every N hours (0 = off)
RADAR_SYNC_INTERVAL_HOURS=0
