    "start": "node --experimental-strip-types src/worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@compos/agents": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/client": "^5.18.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.18.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
