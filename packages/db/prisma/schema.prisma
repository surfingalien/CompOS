// Seed schema for the main application database.
//
// This is intentionally minimal: the full control-framework / evidence /
// policy / questionnaire / vendor / incident schema referenced throughout
// the platform design (frameworks, controls, evidence, tasks, policies,
// vendors, incidents, questionnaires, DSAR requests, API keys, webhooks…)
// is a large, separate modeling effort that hasn't been built in this
// repo yet. What's here is just enough for packages/db/src/client.ts and
// the RLS pattern it wires up to generate and be exercised end-to-end.
//
// Extend this file as each domain module lands; every org-scoped table
// added here MUST get FORCE ROW LEVEL SECURITY (see rls.sql) or the
// multi-tenant isolation this platform depends on breaks silently.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  apiKeys   ApiKey[]

  @@map("organizations")
}

model ApiKey {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  hashedKey      String       @unique
  scopes         String[]     @default([])
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  @@index([organizationId])
  @@map("api_keys")
}
